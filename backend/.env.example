# Server
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database — SQLite for local; PostgreSQL for Docker
DATABASE_URL=sqlite:///./chatgpt_clone.db
# DATABASE_URL=postgresql://chatgpt:chatgpt@db:5432/chatgpt

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_MINUTES=10080

# Optional: OpenAI for real LLM responses + DALL·E images
# Without a key, chat uses demo replies and images use Pollinations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1.5

# Optional: Redis caching (falls back to in-memory cache if unavailable)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300
